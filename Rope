Experiment 5 — File Handling (fs)
import fs from 'fs';
// READ
fs.readFile('data.txt', 'utf8', (err, data) => {
if (err) return console.log(err);
console.log(data);
});
// WRITE (overwrites)
fs.writeFile('data.txt', 'Hello World', err => {
if (err) return console.log(err);
console.log('File written');
});
// APPEND
fs.appendFile('data.txt', '\\nNew Line', err => {
if (err) return console.log(err);
console.log('Content appended');
});
Create data.txt in the project folder. readFile reads; writeFile overwrites; appendFile adds to the end.
Experiment 6 — Middleware
app.use(express.static('public'));
function validateGenre(req, res, next) {
if (!req.query.genre) {
return res.send('Genre is required');
}
next();
function handleSearch(req, res) {
res.send(`Searching for genre: ${req.query.genre}`);
}
}
app.get('/search', validateGenre, handleSearch);
next() passes control to the next middleware. Middleware order matters.
