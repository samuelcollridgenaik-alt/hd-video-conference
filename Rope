Experiment 7 — Custom Modules
Create separate .js files. Named exports use braces on import; default exports do not.
mathUtils.js — named exports
export const add = (a, b) => a + b;
export const subtract = (a, b) => a - b;
export const PI = 3.14;
stringUtils.js — default export
const upper = str => str.toUpperCase();
const lower = str => str.toLowerCase();
const reverse = str => str.split('').reverse().join('');
export default { upper, lower, reverse };
arrayUtils.js — named exports
export const first = arr => arr[0];
export const last = arr => arr[arr.length - 1];
export const sum = arr => arr.reduce((a, b) => a + b, 0);
fileUtils.js — default + named exports
import fs from 'fs';
export default function greet() {
console.log('Hello from fileUtils');
}
export function readData(path) {
return fs.readFileSync(path, 'utf8');
}
export function saveData(path, data) {
fs.writeFileSync(path, data);
}
index.js — import examples
import { add, subtract, PI } from './mathUtils.js';
import stringUtils from './stringUtils.js';
import * as arrayUtils from './arrayUtils.js';
import greet, { readData, saveData } from './fileUtils.js';
console.log(add(2, 3));
console.log(stringUtils.upper('hello'));
console.log(arrayUtils.sum([1, 2, 3]));
greet();
