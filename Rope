Experiment 4 — CRUD Routes
CRUD = Create (POST), Read (GET), Update (PUT), Delete (DELETE). JSON body parsing is required for POST/PUT.
app.use(express.json());
let items = [];
let nextId = 1;
// CREATE
app.post('/items', (req, res) => {
const item = { id: nextId++, ...req.body };
items.push(item);
res.send(item);
});
// READ all
app.get('/items', (req, res) => res.send(items));
// READ one
app.get('/items/:id', (req, res) => {
const item = items.find(i => i.id === Number(req.params.id));
res.send(item);
});
// UPDATE
app.put('/items/:id', (req, res) => {
const item = items.find(i => i.id === Number(req.params.id));
if (!item) return res.status(404).send('Not found');
Object.assign(item, req.body);
res.send(item);
});
// DELETE
app.delete('/items/:id', (req, res) => {
const index = items.findIndex(i => i.id === Number(req.params.id));
if (index === -1) return res.status(404).send('Not found');
const [deleted] = items.splice(index, 1);
res.send(deleted);
});
Remember: push() adds; find() locates; Object.assign() updates; splice() removes.
