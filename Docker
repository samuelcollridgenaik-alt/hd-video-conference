import 'dart:io';
void main() {
while (true) {
print("\n===== PATTERN MENU =====");
print("1. Right Triangle");
print("2. Inverted Right Triangle");
print("3. Square");
print("4. Pyramid");
print("5. Number Triangle");
print("6. Exit");
stdout.write("Enter your choice: ");
int choice = int×parse(stdin×readLineSync()!);
if (choice == 6) {
print("Thank you! Program exited.");
break;
}
if (choice >= 1 && choice <= 5) {
stdout.write("Enter the number of rows: ");
int rows = int×parse(stdin×readLineSync()!);
switch (choice) {
case 1:
print("\nRight Triangle:");
for (int i = 1; i <= rows; i++) {
for (int j = 1; j <= i; j++) {
stdout.write("* ");
}
print("");
}
break;
case 2:
print("\nInverted Right Triangle:");
for (int i = rows; i >= 1; i--) {
for (int j = 1; j <= i; j++) {
stdout.write("* ");
}
print("");
}
break;
case 3:
print("\nSquare:");
for (int i = 1; i <= rows; i++) {
for (int j = 1; j <= rows; j++) {
stdout.write("* ");
}
print("");
}
break;
case 4:
print("\nPyramid:");
for (int i = 1; i <= rows; i++) {
for (int j = 1; j <= rows - i; j++) {
stdout.write(" ");
}
for (int j = 1; j <= (2 * i - 1); j++) {
stdout.write("*");
}
print("");
}
break;
case 5:
print("\nNumber Triangle:");
for (int i = 1; i <= rows; i++) {
for (int j = 1; j <= i; j++) {
stdout.write("$j ");
}
print("");
}
break;
}
} else {
print("Invalid choice! Please select 1 to 6.");
}
}
}
