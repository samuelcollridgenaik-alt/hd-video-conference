Exercise 4 — Statistics
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm
marks = [78,85,90,67,72,88,91,95,56,64,75,90,93,97,80]
df = pd.DataFrame({"Marks": marks})
print("Mean:", np.mean(df["Marks"]))
print("Median:", np.median(df["Marks"]))
mode_result = stats.mode(df["Marks"], keepdims=True)
print("Mode:", mode_result.mode[0])
print("Mode Frequency:", mode_result.count[0])
print("Standard Deviation:", np.std(df["Marks"]))
print("Variance:", np.var(df["Marks"]))
print("Minimum:", np.min(df["Marks"]))
print("Maximum:", np.max(df["Marks"]))
print("Range:", np.max(df["Marks"]) - np.min(df["Marks"]))
print("Quartiles:")
print(df["Marks"].quantile([0.25,0.50,0.75]))
print("Skewness:", stats.skew(df["Marks"]))
print("Kurtosis:", stats.kurtosis(df["Marks"]))
print("25th Percentile:", np.percentile(df["Marks"],25))
print("50th Percentile:", np.percentile(df["Marks"],50))
print("75th Percentile:", np.percentile(df["Marks"],75))
summary = sm.stats.DescrStatsW(df["Marks"])
print("Statsmodels Mean:", summary.mean)
print("Statsmodels Variance:", summary.var)
print("Statsmodels SD:", summary.std)
print("Observations:", summary.nobs)
print(df.describe())
